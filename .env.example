# Copy to .env (next to docker-compose.yml) and fill in — docker compose reads it automatically.
# Do NOT commit the real .env.

# ── PostgreSQL ───────────────────────────────────────────────────────────────────
POSTGRES_USER=buelo
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=buelo

# ── Web ──────────────────────────────────────────────────────────────────────────
# Host port the editor UI is served on → open http://localhost:${WEB_PORT}
WEB_PORT=8080

# ── API ──────────────────────────────────────────────────────────────────────────
# CORS origins allowed by the API (comma-separated). Only needed when a browser calls the
# API cross-origin; with the bundled web (nginx proxy) the calls are same-origin, so unused.
BUELO_CORS_ORIGINS=http://localhost:8080

# Optional Bearer API-key gate. Empty = auth off. If set, API clients must send it.
BUELO_API_KEY=

# ── Prebuilt images (GHCR) ─────────────────────────────────────────────────────────
# Used only for `docker compose pull` (no-build run). Owner of the ghcr.io images and the tag to
# run (edge = rolling master; or pin a release like 1.2.3). Ignored when building from source.
GHCR_OWNER=jhonattan111
IMAGE_TAG=edge
